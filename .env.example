# Reown (WalletConnect) project ID — create at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ---- Xphere Mainnet (chainId 20250217) ----
# Optional RPC/explorer overrides (defaults: en-bkk.x-phere.com / xp.tamsa.io)
# NEXT_PUBLIC_XPHERE_RPC=
# NEXT_PUBLIC_XPHERE_EXPLORER=

# PumpkinSwap DEX contracts on Xphere — swaps route to their pools; LP is
# provisioned on pumpkinswap.app. These are baked into lib/chain.ts as
# defaults (verified on-chain); set here only to override.
# NEXT_PUBLIC_DEX_ROUTER=0xFCa5FC96a94bF6D98eE266de8E811Ed39B737e64
# NEXT_PUBLIC_DEX_FACTORY=0xFca8cA57D8f3bA44428Ab6bd7CF2960496cA420E
# NEXT_PUBLIC_WXP=0xB872ce6a30e63080488e5BAd468e870ABdc94FF5

# Game / airdrop contracts on Xphere (empty = feature disabled until deployed)
NEXT_PUBLIC_LMS_CONTRACT=
# Block the LMS contract was deployed at (deploy:lms prints it) — bounds the
# event scans on /games so they don't sweep the whole 40M+ block chain.
NEXT_PUBLIC_LMS_DEPLOY_BLOCK=
NEXT_PUBLIC_AIRDROP_CONTRACT=

# Admin auth (server-only — never exposed to the client)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Durable analytics (visitors / wallet connections / 24h volume). Provision an
# Upstash Redis DB in the Vercel dashboard (Storage → Upstash for Redis) — it
# auto-injects KV_REST_API_* (those names work too). Without them, analytics
# fall back to per-instance memory and reset on every redeploy/cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Super admin wallets for /admin (comma-separated). Unset = contract owners.
# ADMIN_SUPER_WALLETS=0x...,0x...

# First block of the current MerkleAirdrop deployment (bounds event scans).
# Unset = the verified mainnet default in lib/onchain-campaigns.ts.
# NEXT_PUBLIC_AIRDROP_DEPLOY_BLOCK=45816553

# Local-dev only: lets a password-only session act as super admin on
# localhost (no wallet needed). Never set in production.
# ADMIN_DEV_BYPASS=1
