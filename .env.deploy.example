# Copy to .env.deploy (gitignored) and fill in.
# Used by `npm run deploy:lms` / `npm run deploy:airdrop` — XPHERE MAINNET.

# Deployer private key. Fund it with a little XP for gas (~0.2 XP).
# This key becomes the contract OWNER — keep it safe.
DEPLOYER_PRIVATE_KEY=

# Optional: override the Xphere RPC (default: https://en-bkk.x-phere.com)
# XPHERE_RPC=

# KangLMS constructor wiring (defaults match the /games page)
# LMS_TOKEN=      bet token (default: KDG on Xphere)
# LMS_TREASURY=   treasury wallet
# LMS_BURN=       burn wallet
